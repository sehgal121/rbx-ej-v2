body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

#store-locator {
    display: flex;
    flex-wrap: wrap;
    height: 100vh;
}

#store-list {
    width: 30%;
    padding: 10px;
    box-sizing: border-box;
    background-color: #f8f8f8;
    overflow-y: auto; /* Add scrollbar when needed */
  /*   max-height: 90vh; Ensure it takes up 90% of the viewport height */
    max-height: 100%;
    position: relative; /* Needed for positioning the button */
}

#store-list button {
    position: sticky; /* Fixes the button to the top */
    top: 0;
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    background-color: #007bff;
    color: white;
    border: none;
    cursor: pointer;
    z-index: 10; /* Ensure it stays above other content */
}

#store-list button:hover {
    background-color: #0056b3;
}

#store-items {
    list-style: none;
    padding: 0;
    margin: 0;
}

#store-items li {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    padding: 10px;
    background-color: white;
    border: 1px solid #ccc;
    cursor: pointer;
}

#store-items img {
    width: 80px;
    height: 80px;
    margin-right: 10px;
}

#store-items div {
    flex: 1;
}

#store-items .store-name {
    font-size: 16px; /* Increase size of store name */
    font-weight: bold;
}

#store-items .country {
    font-size: 12px; /* Adjust font size for country */
    color: #555;
}

#store-items p {
    font-size: 12px; /* Reduce text size for address and phone */
}

#store-items a {
    color: inherit; /* Set hyperlink text color to match surrounding text */
    text-decoration: none;
}

#store-items a:hover {
    text-decoration: underline;
}

#map {
    width: 70%;
    height: 100%;
}

#map .leaflet-popup-content h4 {
    font-size: 18px; /* Increase size of store name in popup */
    font-weight: bold;
}

#map .leaflet-popup-content img {
    width: 100%; /* Make image in popup 100% of popup width */
}

@media (max-width: 768px) {
    #store-locator {
        flex-direction: column;
    }

    #store-list {
        width: 100%;
        height: 90vh; /* List section takes up 90% of the viewport height */
    }

    #map {
        display: none; /* Hide the map section */
    }

    #store-list button {
        display: none; /* Remove the reset button in mobile view */
    }
}
